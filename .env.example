# Google Gemini API Key for NLP parsing of raw supermarket HTML search results
GEMINI_API_KEY=

# Internal URL for the scraper-pod microservice
SCRAPER_SERVICE_URL=http://scraper-pod:3002/scrape

# Shared secret token for authenticating internal requests to scraper-pod
# Generate a secure random token with: openssl rand -hex 24
SCRAPE_TOKEN=

# Allowed CORS client origin for logic-api
CLIENT_ORIGIN=http://localhost:5173
