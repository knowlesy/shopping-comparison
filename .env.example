# =============================================================================
# ShoppingWise UK — Environment Configuration Example
# =============================================================================

# --- Core Server & Networking ---
# HTTP port for logic-api (default: 3001)
PORT=3001
# Allowed CORS client origin for logic-api (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
# Runtime environment mode (development, test, or production)
NODE_ENV=development

# --- Tier 1: Direct Store Fetcher Sidecar ---
# Internal URL for the Python store-fetcher direct adapter microservice
STORE_FETCHER_URL=http://127.0.0.1:3003
# Shared secret token for authenticating internal requests to store-fetcher
FETCHER_TOKEN=local-dev-fetcher-token-shopping-app

# --- Tier 2: Scraper Pod Microservice ---
# Internal URL for the scraper-pod Chromium microservice
SCRAPER_SERVICE_URL=http://127.0.0.1:3002/scrape
# Shared secret token for authenticating internal requests to scraper-pod
SCRAPE_TOKEN=local-dev-scrape-token-shopping-app

# --- Outbound Proxy Configuration (Optional) ---
# Upstream proxy URL for store-fetcher outbound requests (unset by default for home residential)
PROXY_URL=
# Proxy classification type used by store-fetcher (residential, static_isp, or datacenter)
PROXY_TYPE=residential

# --- AI Matching & Intent Extraction ---
# Google Gemini API key for hybrid AI candidate review and query parsing
GEMINI_API_KEY=
# Google Gemini model identifier used for evaluation and review (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Google Gemini escalation model for batched review of hard/unresolved cases (default: gemini-2.5-flash)
GEMINI_ESCALATION_MODEL=gemini-2.5-flash
# Maximum candidates reviewed by per-item AI pass (default: 25)
AI_CANDIDATE_CAP=25
# Master toggle enabling Gemini AI matching review (true/false)
ENABLE_GEMINI_MATCHING=false

# --- Authentication & GitHub Versioning ---
# Feature flag to enable session authentication and login routes (true/false)
ENABLE_AUTH=false
# GitHub repository slug used for checking latest releases in Settings (owner/repo)
GITHUB_REPO=knowlesy/shopping-comparison
# Container image registry host used for release and system update metadata
IMAGE_REGISTRY=ghcr.io

# --- Persistence & Data Directory ---
# Directory path for storing persistent price cache and snapshot history on disk
DATA_DIR=data

# --- File Path Overrides (Optional) ---
# Path override for the offline benchmark catalog JSON file
CATALOG_PATH=data/catalog.json
# Path override for the cross-category contamination rules JSON file
CONTAMINATION_RULES_PATH=data/contamination-rules.json
# Path override for the product scoring matching rules JSON file
MATCHING_RULES_PATH=data/matching-rules.json
# Path override for CHANGELOG.md file used by the system release version checker
CHANGELOG_PATH=CHANGELOG.md
