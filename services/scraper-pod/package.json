{
  "name": "scraper-pod",
  "version": "1.3.0",
  "description": "Headless Scraper Pod using puppeteer-real-browser for Cloudflare/Turnstile bypass",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:scrape": "node src/test-client.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "puppeteer-real-browser": "^1.4.4"
  },
  "overrides": {
    "extract-zip": "2.0.1",
    "rebrowser-puppeteer-core": {
      "@puppeteer/browsers": {
        "extract-zip": "2.0.1"
      }
    }
  }
}
