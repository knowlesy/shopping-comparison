{
  "name": "uk-supermarket-shopping-app",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/knowlesy/shopping-comparison"
  },
  "scripts": {
    "dev": "concurrently -n \"scraper,logic,client\" -c \"blue,green,magenta\" \"npm run dev:scraper\" \"npm run dev:logic\" \"npm run dev:client\"",
    "dev:scraper": "node services/scraper-pod/src/server.js",
    "dev:logic": "node services/logic-api/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "lint": "eslint services/",
    "format": "prettier --write \"services/**/*.js\" \"tests/**/*.js\"",
    "test": "node --test services/logic-api/src/services/*.test.js",
    "test:owasp": "node tests/owasp-security-audit.js",
    "test:live": "node tests/test-live-scraper.js",
    "bench:matching": "node scripts/dev/compare_matching.js",
    "test:food-form": "node tests/food-form-and-variety-audit.js",
    "test:uncached-20": "node tests/uncached-20-lists-30-items-audit.js",
    "test:recipes-20": "node tests/verify-20-recipes.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6"
  }
}
