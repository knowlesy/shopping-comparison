{
  "name": "uk-supermarket-shopping-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"scraper,logic,client\" -c \"blue,green,magenta\" \"npm run dev:scraper\" \"npm run dev:logic\" \"npm run dev:client\"",
    "dev:scraper": "node services/scraper-pod/src/server.js",
    "dev:logic": "node services/logic-api/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test": "node --test tests/*.test.js services/logic-api/src/services/*.test.js || echo 'No unit tests yet'",
    "test:food-form": "node tests/food-form-and-variety-audit.js",
    "test:uncached-20": "node tests/uncached-20-lists-30-items-audit.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2"
  }
}
